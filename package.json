{
  "name": "ai-office",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Matias Lambert at Iquall Networks",
  "description": "A local roundtable where several Claude Code agents discuss one question and write the documents that come out of it.",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "devDependencies": {
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm -w @ai-office/server run dev",
    "dev:web": "npm -w @ai-office/web run dev",
    "build": "npm -w @ai-office/web run build",
    "start": "npm run build && npm -w @ai-office/server run start",
    "typecheck": "npm -w @ai-office/server run typecheck && npm -w @ai-office/web run typecheck",
    "doctor": "tsx server/src/doctor.ts",
    "prompt": "tsx server/src/prompt-preview.ts",
    "order": "tsx server/src/sim-order.ts",
    "protocol": "tsx server/src/show-protocol.ts",
    "privacy": "sh .githooks/privacy-scan"
  }
}
